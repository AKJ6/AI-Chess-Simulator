QMainWindow {
    background-color: #2c2f33;
    color: #ffffff;
}

QWidget {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #ffffff;
}

QPushButton {
    background-color: #7289da;
    border: none;
    padding: 10px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #5b6eae;
}

QPushButton:pressed {
    background-color: #4a5a8f;
}

QTextEdit {
    background-color: #23272a;
    border: 1px solid #7289da;
    border-radius: 3px;
    padding: 5px;
    font-family: Consolas, monospace;
}

QLabel {
    font-size: 14px;
    font-weight: bold;
}
